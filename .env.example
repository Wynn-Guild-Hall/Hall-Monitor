# Discord
TOKEN=
PREFIX=~
DISCORD_GUILD_ID=
WELCOME_CHANNEL_ID=

# Discord role IDs
DELEGATE_ROLE_ID=
RELEGATE_ROLE_ID=
EXTERNAL_RELEGATE_ROLE_ID=
OBSERVER_ROLE_ID=
JANITOR_ROLE_ID=
MONITOR_ROLE_ID=
OWNERSHIP_CONTACT_ROLE_ID=
WARRING_CONTACT_ROLE_ID=
HOUSING_CONTACT_ROLE_ID=
EVENTS_CONTACT_ROLE_ID=

# HTTP sidecar
HALL_MONITOR_PORT=9423

# Storage
DATA_DIR=/app/data

# External APIs
WYNNCRAFT_API_BASE=https://api.wynncraft.com
# Leave empty to run unauthenticated (works, but shares the anon ratelimit).
# When we obtain a token, set it here for a private application ratelimit.
WYNNCRAFT_API_TOKEN=
WYNNPOOL_API_BASE=https://api.wynnpool.com
MOJANG_API_BASE=https://api.mojang.com
PLAYERDB_API_BASE=https://playerdb.co

# PendingInvite lifecycle
PENDING_INVITE_TTL_MINUTES=45
PENDING_INVITE_SWEEP_SECONDS=60

# Notability recompute cadence
NOTABILITY_REFRESH_SECONDS=3600
